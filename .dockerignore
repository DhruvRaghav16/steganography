# Keep the build context small and the image reproducible.
# Anything generated is rebuilt inside the container, so it must not be
# copied in from the host.

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated artifacts -- the Dockerfile regenerates these at build time.
model.pkl
images/
experiments/results/
*.png

.git/
.github/
.gitignore
Dockerfile
.dockerignore
