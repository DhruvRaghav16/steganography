# Build artifacts. The model is produced by `stego train` in a few
# seconds -- committing it would ask people to joblib.load() an untrusted
# pickle, which executes arbitrary code.
*.pkl

# Generated cover images. Regenerate with:
#   python experiments/make_images.py
images/*.png

# Experiment output. The two result charts ARE committed -- the README
# displays them, and a reader should not have to run anything to see the
# findings. The CSV is regenerated by experiments/exp2_compare.py.
experiments/results/*.csv

# Stego images produced while testing
secret.png
stego*.png

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.idea/
.vscode/
.DS_Store
